<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 自動更新：GitHub Releases の確認と取得、自分自身のインストール -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 天気：おおよその位置（任意。地名で選ぶこともできる） -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- ウィジェットを置く（実際の割り当ては確認画面で許可する） -->
    <uses-permission android:name="android.permission.BIND_APPWIDGET" tools:ignore="ProtectedPermissions" />
    <!-- おうちのひとからの呼びかけ：常駐して待ち受け、動画を見ていてもホームを前に出す -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Android 11以降: ランチャー表示できるアプリと、動画リンクを開けるアプリを見えるようにする -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".KidsApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.KidsHome">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Netflix / Prime Video などの「共有」からお気に入り登録する -->
        <activity
            android:name=".AddFavoriteActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/share_label"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- レスキュー：ホームが落ち続ける・固まったときの画面とクイック設定のタイル。本体と別のプロセス -->
        <activity
            android:name=".rescue.RescueActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="キッズホームのレスキュー"
            android:process=":rescue"
            android:taskAffinity="com.theta.kidshome.rescue"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <service
            android:name=".rescue.RescueTile"
            android:exported="true"
            android:icon="@drawable/ic_rescue"
            android:label="キッズホームのレスキュー"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:process=":rescue">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".remote.RemoteService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="保護者から子どものタブレットへの呼びかけ（「そろそろ終わりだよ」）を待ち受けて表示する" />
        </service>

        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />
    </application>
</manifest>
