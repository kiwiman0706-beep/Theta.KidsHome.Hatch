<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 自動更新：GitHub Releases の確認と取得、自分自身のインストール -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 天気：おおよその位置（任意。地名で選ぶこともできる） -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- ウィジェットを置く（実際の割り当ては確認画面で許可する） -->
    <uses-permission android:name="android.permission.BIND_APPWIDGET" tools:ignore="ProtectedPermissions" />
    <!-- おうちのひとからの呼びかけ：常駐して待ち受け、動画を見ていてもホームを前に出す -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 端末（本体・SD カード）の動画・音楽・オーディオブック -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- カレンダーの予定（任意） -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- がっき：マイクで録った音をパッドに（サンプラー） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android TV でも使えるように（タッチ・マイク・位置は無くてもよい） -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <!-- Android 11以降: ランチャー表示できるアプリと、動画リンクを開けるアプリを見えるようにする -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- くくの ひょう の 読み上げ（音声読み上げエンジン） -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".KidsApp"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.KidsHome">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Netflix / Prime Video などの「共有」からお気に入り登録する -->
        <activity
            android:name=".AddFavoriteActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/share_label"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- レスキュー：ホームが落ち続ける・固まったときの画面とクイック設定のタイル。本体と別のプロセス -->
        <activity
            android:name=".rescue.RescueActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="キッズホームのレスキュー"
            android:process=":rescue"
            android:taskAffinity="com.theta.kidshome.rescue"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <service
            android:name=".rescue.RescueTile"
            android:exported="true"
            android:icon="@drawable/ic_rescue"
            android:label="キッズホームのレスキュー"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:process=":rescue">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".remote.RemoteService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="保護者から子どものタブレットへの呼びかけ（「そろそろ終わりだよ」）を待ち受けて表示する" />
        </service>

        <!-- 音楽・オーディオブックを裏でも鳴らす（通知・ロック画面・車のボタン） -->
        <service
            android:name=".media.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- 設定の書き出し（.xlsx）を共有する -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />
        <!-- QR コード読み取り（タブレットの向きのまま） -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            tools:replace="screenOrientation" />
    </application>
</manifest>
